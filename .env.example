# Transactional mail for the contact form, via the self-hosted Plunk in
# questpie-gitops-v2 (apps/base/plunk). Without PLUNK_API_KEY the form returns
# 500 and the page falls back to telling people to use the mailto link.
PLUNK_API_KEY=

# Only set this if Plunk moves off the eu-infra host.
# PLUNK_API_BASE_URL=https://api.plunk.eu-infra.questpie.com

# Self-hosted Umami. Both values are public — they ship in the page HTML — and
# both have working defaults in src/components/analytics.tsx. Override only to
# point a fork somewhere else.
# NEXT_PUBLIC_UMAMI_SRC=https://umami.eu-infra.questpie.com/script.js
# NEXT_PUBLIC_UMAMI_ID=

# Cap proof-of-work spam check (apps/base/cap in questpie-gitops-v2). Both must
# be set or the check is skipped entirely; the honeypot and rate limit remain.
CAP_SECRET=
NEXT_PUBLIC_CAP_SITE_KEY=
# NEXT_PUBLIC_CAP_BASE_URL=https://cap.eu-infra.questpie.com
